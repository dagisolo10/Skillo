generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id         String   @id @default(uuid())
    name       String
    username   String   @unique
    email      String   @unique
    avatarSeed String   @default("Felix")
    credits    Int      @default(2)
    createdAt  DateTime @default(now())
    skills     Skill[]
}

model Skill {
    id          String        @id @default(uuid())
    name        String
    emoji       String?
    description String
    category    SkillCategory @default(Other)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([category])
}

enum SkillCategory {
    Tech
    Other
    Music
    Design
    Crafts
    Wellness
    Languages
}
