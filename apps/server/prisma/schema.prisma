generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["partialIndexes"]
}

datasource db {
    provider = "postgresql"
}

model User {
    id         String   @id @default(uuid())
    name       String
    bio        String?
    username   String   @unique
    email      String   @unique
    avatarSeed String   @default("Felix")
    credits    Int      @default(2)
    createdAt  DateTime @default(now())
    skills     Skill[]

    taughtSessions  Session[] @relation("TaughtSessions")
    learnedSessions Session[] @relation("LearnedSessions")
}

model Skill {
    id          String        @id @default(uuid())
    name        String
    emoji       String?
    description String
    category    SkillCategory @default(Other)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    deletedAt   DateTime?

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    sessions Session[]

    @@index([userId])
    @@index([category])
    @@index([deletedAt])
}

model Session {
    id         String        @id @default(uuid())
    status     SessionStatus @default(PENDING)
    createdAt  DateTime      @default(now())
    acceptedAt DateTime?

    skillId String
    skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

    mentorId String
    mentor   User   @relation("TaughtSessions", fields: [mentorId], references: [id], onDelete: Cascade)

    learnerId String
    learner   User   @relation("LearnedSessions", fields: [learnerId], references: [id], onDelete: Cascade)

    @@unique([learnerId, skillId], where: raw("status IN ('PENDING', 'ACTIVE')"))
    @@index([status])
    @@index([skillId])
    @@index([mentorId])
    @@index([learnerId])
}

enum SessionStatus {
    PENDING
    ACTIVE
    COMPLETED
    CANCELLED
}

enum SkillCategory {
    Tech
    Other
    Music
    Design
    Crafts
    Wellness
    Languages
}
